# Generate three independent secrets: python -c 'import secrets; print(secrets.token_urlsafe(48))'
ENVIRONMENT=production
RUN_BACKGROUND_TASKS=false
DATABASE_URL=postgresql+asyncpg://opstrail_runtime:REPLACE_ME@db.internal:5432/opstrail
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INTAKE_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPS_METRICS_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_HOST=https://opstrail.internal
MSTEAMS_ENABLED=true
MSTEAMS_POWER_AUTOMATE_URL=
MSTEAMS_AUTH=none
OUTBOUND_WEBHOOK_ENABLED=false
DISPATCH_CONCURRENCY=8
DISPATCH_TIMEOUT_SECONDS=15
DISPATCH_LEASE_SECONDS=120
# Start conservatively. Tune to actual per-destination quota during pilot.
DISPATCH_TARGET_INTERVAL_SECONDS=1
BACKLOG_DIGEST_AFTER_SECONDS=300
BACKLOG_DIGEST_MAX_EVENTS=100
BACKLOG_RETENTION_HOURS=168
ALERT_RETENTION_MONTHS=6
NOTIFICATION_RETENTION_MONTHS=3
