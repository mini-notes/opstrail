{#-
  Adaptive Card mặc định — rendered straight to JSON.

  Cố ý ngắn. Người trực cần biết: cái gì hỏng, nặng đến đâu, số đo hiện tại,
  ở đâu, và làm gì tiếp. Team/Owner không nằm trên card — chúng điều khiển
  việc gửi vào channel nào và dựng dashboard, là việc khác.

  Every interpolated value goes through `| tojson` so quotes, newlines and
  unicode in an alert annotation cannot break the document. Never write a bare
  {{ value }} inside a JSON string here.

  Context:
    alert, service, severity, status, icon, status_icon
    value_line       "93% (ngưỡng 85%)" hoặc None  ← cần rule đặt annotation
    duration_line    "Đã xử lý sau 00:42:15" hoặc None
    facts            (tiêu đề, giá trị) đã lọc rỗng
    mention_entities · mention_text   (rỗng nếu không mention)
    generator_url, detail_url, runbook_url, dashboard_url, silence_url
-#}
{%- set resolved = status == "RESOLVED" -%}
{%- set accent = "Good" if resolved
                 else ("Attention" if severity in ("CRITICAL", "ERROR") else "Warning") -%}
{%- set headline = duration_line if resolved else value_line -%}
{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "msteams": {
    "width": "Full"
    {#- Không mention trên card resolved: việc đã xong, không cần đánh thức ai. -#}
    {%- if mention_entities and not resolved %},
    "entities": [
      {%- for e in mention_entities %}
      { "type": "mention",
        "text": {{ e.text | tojson }},
        "mentioned": { "id": {{ e.mentioned.id | tojson }},
                       "name": {{ e.mentioned.name | tojson }} } }{{ "," if not loop.last }}
      {%- endfor %}
    ]
    {%- endif %}
  },
  "body": [
    {
      "type": "TextBlock",
      "text": {{ (status_icon ~ " " ~ ("RESOLVED" if resolved else severity)
                  ~ " · " ~ (alert.alertname or "Unknown alert")) | tojson }},
      "weight": "Bolder",
      "size": "Large",
      "wrap": true,
      "color": {{ accent | tojson }}
    }
    {%- if mention_text and not resolved %},
    {
      "type": "TextBlock",
      "text": {{ mention_text | tojson }},
      "wrap": true,
      "weight": "Bolder",
      "color": {{ accent | tojson }},
      "spacing": "Small"
    }
    {%- endif %}
    {%- if headline %},
    {
      "type": "TextBlock",
      "text": {{ headline | tojson }},
      "weight": "Bolder",
      "size": "Large",
      "wrap": true,
      "color": {{ accent | tojson }},
      "spacing": "Medium"
    }
    {%- endif %}
    {%- if alert.summary and not resolved %},
    {
      "type": "TextBlock",
      "text": {{ alert.summary | tojson }},
      "wrap": true,
      "spacing": "Small"
    }
    {%- endif %}
    {%- if facts %},
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {%- for name, value in facts %}
        { "title": {{ name | tojson }}, "value": {{ value | tojson }} }{{ "," if not loop.last }}
        {%- endfor %}
      ]
    }
    {%- endif %}
    {%- if alert.annotations and alert.annotations.get('impact') and not resolved %},
    {
      "type": "TextBlock",
      "text": {{ ("Ảnh hưởng: " ~ alert.annotations.get('impact')) | tojson }},
      "wrap": true,
      "color": "Attention",
      "spacing": "Medium"
    }
    {%- endif %}
  ]
  {%- set acts = [] -%}
  {%- if not resolved -%}
    {%- if runbook_url %}{% set _ = acts.append(("📖 Runbook", runbook_url)) %}{% endif -%}
    {%- if dashboard_url %}{% set _ = acts.append(("📊 Dashboard", dashboard_url)) %}{% endif -%}
    {%- if generator_url %}{% set _ = acts.append(("🔍 Prometheus", generator_url)) %}{% endif -%}
  {%- endif -%}
  {%- if detail_url %}{% set _ = acts.append(("🗂 OpsTrail", detail_url)) %}{% endif -%}
  {#- Không còn gì để tắt khi alert đã hết. -#}
  {%- if silence_url and not resolved %}{% set _ = acts.append(("🔕 Silence", silence_url)) %}{% endif -%}
  {%- if acts %},
  "actions": [
    {%- for title, url in acts %}
    { "type": "Action.OpenUrl", "title": {{ title | tojson }}, "url": {{ url | tojson }} }{{ "," if not loop.last }}
    {%- endfor %}
  ]
  {%- endif %}
}
