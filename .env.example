# Consumed by `docker compose` for ${VAR} interpolation.
# Values must be reachable FROM INSIDE the compose network (service names).
# For running uvicorn on the host instead, use .env.local.
POSTGRES_PASSWORD=opstrail
INTAKE_TOKEN=change-me
SESSION_SECRET=change-me-32-chars-min
PUBLIC_HOST=http://localhost:8000
MSTEAMS_POWER_AUTOMATE_URL=http://teams-mock:8080/teams
# Mention trong card Teams
# upn  = dung email/UPN  (mac dinh, hop voi da so tenant)
# aad  = dung AAD Object ID (neu card hien dung ten ma khong day thong bao)
MSTEAMS_MENTION_ID_FIELD=upn
MENTION_SEVERITY_DEFAULT=critical

OUTBOUND_WEBHOOK_ENABLED=true
OUTBOUND_WEBHOOK_URL=http://teams-mock:8080/other
ALERT_RETENTION_MONTHS=6

# --- Xac thuc khi goi Power Automate ---------------------------------------
# none | bearer | entra. Doc docs/msteams-auth.md TRUOC khi doi: gui header tu
# OpsTrail chi co tac dung neu flow BEN KIA doi header do.
MSTEAMS_AUTH=none
# bearer: bi mat tinh, OpsTrail gui kem moi request
MSTEAMS_AUTH_TOKEN=
MSTEAMS_AUTH_HEADER=Authorization
MSTEAMS_AUTH_SCHEME=Bearer
# entra: client credentials. Stack dev tro san vao mock-entra.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=mock-client-id
ENTRA_CLIENT_SECRET=mock-client-secret
# Hai dau gach cheo la bat buoc -- xem docs/msteams-auth.md
ENTRA_SCOPE=https://service.flow.microsoft.com//.default
# De rong de dung Entra that (dung tu ENTRA_TENANT_ID).
ENTRA_TOKEN_URL=http://mock-entra:8081/token
