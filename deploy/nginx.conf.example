# Merge into the internal TLS proxy configuration; paths are examples.
limit_req_zone $binary_remote_addr zone=opstrail_login:10m rate=10r/m;
server {
    listen 443 ssl;
    server_name opstrail.internal;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    location = /login {
        limit_req zone=opstrail_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    # Restrict /metrics at the firewall/proxy as well; the app requires a separate bearer token.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
